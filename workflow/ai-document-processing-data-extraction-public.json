    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=You are an invoice data extraction assistant.\n\nExtract structured information from the invoice text provided below.\n\nReturn ONLY valid JSON. Do not include markdown, explanations, or code fences.\n\nUse exactly this structure:\n\n{\n  \"invoice_number\": \"\",\n  \"vendor_name\": \"\",\n  \"invoice_date\": \"\",\n  \"due_date\": \"\",\n  \"currency\": \"\",\n  \"purchase_order\": \"\",\n  \"subtotal\": 0,\n  \"tax\": 0,\n  \"total\": 0,\n  \"line_items\": [\n    {\n      \"description\": \"\",\n      \"quantity\": 0,\n      \"unit_price\": 0,\n      \"amount\": 0\n    }\n  ]\n}\n\nRules:\n- Extract values only from the provided invoice.\n- Do not invent missing information.\n- If a text field is missing, return an empty string.\n- If a numeric field is missing, return 0.\n- Return monetary values as numbers without currency symbols.\n- Preserve all invoice line items that can be identified.\n- Use YYYY-MM-DD for dates when the date can be determined.\n- Return only the JSON object.\n\nINVOICE TEXT:\n\n{{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "invoice_extraction",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"invoice_number\": {\n      \"type\": \"string\"\n    },\n    \"vendor_name\": {\n      \"type\": \"string\"\n    },\n    \"invoice_date\": {\n      \"type\": \"string\"\n    },\n    \"due_date\": {\n      \"type\": \"string\"\n    },\n    \"currency\": {\n      \"type\": \"string\"\n    },\n    \"purchase_order\": {\n      \"type\": \"string\"\n    },\n    \"subtotal\": {\n      \"type\": \"number\"\n    },\n    \"tax\": {\n      \"type\": \"number\"\n    },\n    \"total\": {\n      \"type\": \"number\"\n    },\n    \"line_items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"quantity\": {\n            \"type\": \"number\"\n          },\n          \"unit_price\": {\n            \"type\": \"number\"\n          },\n          \"amount\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\n          \"description\",\n          \"quantity\",\n          \"unit_price\",\n          \"amount\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"invoice_number\",\n    \"vendor_name\",\n    \"invoice_date\",\n    \"due_date\",\n    \"currency\",\n    \"purchase_order\",\n    \"subtotal\",\n    \"tax\",\n    \"total\",\n    \"line_items\"\n  ],\n  \"additionalProperties\": false\n}",
              "description": "Structured invoice data extracted from the supplied invoice document.",
              "strict": true
            }
          }
        }
      },
