      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  // OpenAI structured output is nested here\n  const invoice = item.json.output?.[0]?.content?.[0]?.text;\n\n  if (!invoice || typeof invoice !== 'object') {\n    return {\n      json: {\n        is_valid: false,\n        validation_status: 'Needs Review',\n        validation_errors: ['Structured invoice data was not found in the AI output']\n      }\n    };\n  }\n\n  const errors = [];\n\n  // Check required text fields\n  const requiredTextFields = [\n    'invoice_number',\n    'vendor_name',\n    'invoice_date',\n    'due_date',\n    'currency'\n  ];\n\n  for (const field of requiredTextFields) {\n    if (!invoice[field] || String(invoice[field]).trim() === '') {\n      errors.push(`Missing required field: ${field}`);\n    }\n  }\n\n  // Check monetary values\n  if (typeof invoice.subtotal !== 'number') {\n    errors.push('Subtotal is missing or invalid');\n  }\n\n  if (typeof invoice.tax !== 'number') {\n    errors.push('Tax is missing or invalid');\n  }\n\n  if (typeof invoice.total !== 'number') {\n    errors.push('Total is missing or invalid');\n  }\n\n  // Check invoice arithmetic: subtotal + tax = total\n  if (\n    typeof invoice.subtotal === 'number' &&\n    typeof invoice.tax === 'number' &&\n    typeof invoice.total === 'number'\n  ) {\n    const calculatedTotal =\n      Math.round((invoice.subtotal + invoice.tax) * 100) / 100;\n\n    const statedTotal =\n      Math.round(invoice.total * 100) / 100;\n\n    if (calculatedTotal !== statedTotal) {\n      errors.push(\n        `Total mismatch: subtotal + tax = ${calculatedTotal}, but invoice total = ${statedTotal}`\n      );\n    }\n  }\n\n  // Check line items\n  if (!Array.isArray(invoice.line_items) || invoice.line_items.length === 0) {\n    errors.push('No invoice line items were extracted');\n  }\n\n  return {\n    json: {\n      ...invoice,\n      is_valid: errors.length === 0,\n      validation_status:\n        errors.length === 0 ? 'Valid' : 'Needs Review',\n      validation_errors: errors\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
